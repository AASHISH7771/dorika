# ─────────────────────────────────────────────────────────────
# Dorika — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project URL + anon key: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: NEVER expose to the browser. Server-only.
# Used by the admin panel & server actions to bypass RLS where required.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin bootstrap ───────────────────────────────────────────
# The email that will be granted the "admin" role by the seed script / trigger.
ADMIN_EMAIL=shopdorika@gmail.com

# ── Spam protection (optional but recommended) ────────────────
# Cloudflare Turnstile — leave blank to disable (honeypot + rate-limit still active)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email (optional — order/custom-request confirmations) ─────
# Example uses Resend. Leave blank to log emails to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Dorika <shopdorika@gmail.com>"

# ── Payments (structure ready — add keys when you go live) ────
# eSewa
NEXT_PUBLIC_ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
# Khalti
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
# Bank transfer / QR (shown to customer; no secret needed)
NEXT_PUBLIC_BANK_NAME="Your Bank Name"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="Dorika"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0000000000000"
NEXT_PUBLIC_BANK_QR_IMAGE_URL=
